---
/* ---------------------------------------------------------------------------
   The finder: what can I make with the spices I have? Prerendered with every
   blend listed A to Z, then hydrated. The island reads the saved cabinet and
   adds the Ready now / Missing counts. Nothing leaves the visitor's browser.
   --------------------------------------------------------------------------- */

import SpicesLayout from "../../layouts/SpicesLayout.astro";
import BlendBrowser from "../../islands/spices/BlendBrowser.tsx";
import { buildFinderData } from "../../lib/spices/finder-data";

const data = buildFinderData();
---

<SpicesLayout
  title="What can I make?"
  description="Pick the spices in your cabinet and see which blends you can make now, and which need just one more."
>
  <div class="spices-page">
    <h1>What can I make?</h1>
    <p class="spices-page__lead">
      Blends sorted by what is already in your cabinet. Add a food to see what suits it.
    </p>
    <p class="lib__hint">
      Your cabinet is saved in this browser only. Nothing is sent anywhere, and
      there are no accounts. Optional spices never hold a blend back.
    </p>

    <BlendBrowser
      blends={data.blends}
      cuisines={data.cuisines}
      uses={data.uses}
      methods={data.methods}
      foodGroups={data.foodGroups}
      finder={{ stapleSlugs: data.stapleList, stapleNote: data.stapleNote }}
      client:load
    />
  </div>
</SpicesLayout>
