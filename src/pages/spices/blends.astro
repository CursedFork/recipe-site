---
/* ---------------------------------------------------------------------------
   Browse blends. Prerendered, then hydrated for the search and filters.
   --------------------------------------------------------------------------- */

import SpicesLayout from "../../layouts/SpicesLayout.astro";
import BlendBrowser, { type FoodGroup } from "../../islands/spices/BlendBrowser.tsx";
import foodsJson from "../../data/foods.json";
import { loadLibrary } from "../../lib/spices/load-spices";
import { methods, uses } from "../../lib/spices/vocab";
import type { LeanFoodRef, LibraryBlend } from "../../lib/spices/blend-filter";
import type { FoodRef } from "../../lib/spices/types";

const library = loadLibrary();
const nameOf = new Map(library.spices.map((spice) => [spice.slug, spice.name]));

const lean = (ref: FoodRef): LeanFoodRef => ({ groupId: ref.groupId, itemId: ref.itemId, name: ref.name });

const blends: LibraryBlend[] = library.blends.map((blend) => ({
  slug: blend.slug,
  name: blend.name,
  aka: blend.aka,
  cuisines: blend.cuisines,
  uses: blend.uses,
  methods: blend.methods,
  classic: blend.classic.map(lean),
  also: blend.also.map(lean),
  ingredientNames: blend.ingredients.map((ingredient) => nameOf.get(ingredient.spiceSlug) ?? ingredient.name),
  ingredientCount: blend.ingredients.length,
  goEasy: blend.goEasy,
  allergens: blend.allergens,
}));

const cuisines = [...new Set(blends.flatMap((blend) => blend.cuisines))]
  .filter((cuisine) => cuisine !== "Global")
  .sort((a, b) => a.localeCompare(b));

// Only list the uses and methods at least one blend actually has.
const usedUses = new Set(blends.flatMap((blend) => blend.uses));
const usedMethods = new Set(blends.flatMap((blend) => blend.methods));

const foodGroups: FoodGroup[] = (foodsJson as { groups: FoodGroup[] }).groups.map((group) => ({
  id: group.id,
  name: group.name,
  items: group.items.map((item) => ({ id: item.id, name: item.name })),
}));
---

<SpicesLayout
  title="Spice blends"
  description="Spice blends from around the world, with what each goes with and how to use it."
>
  <div class="spices-page">
    <h1>Spice blends</h1>
    <p class="spices-page__lead">
      Mixes of the spices in the library, with what each one goes well with.
    </p>
    <p class="lib__hint">
      Amounts are in parts, so one part can be any spoon you like. They are typical
      versions to start from, and each page says where it came from.
    </p>

    <BlendBrowser
      blends={blends}
      cuisines={cuisines}
      uses={uses.names.filter((name) => usedUses.has(name))}
      methods={methods.names.filter((name) => usedMethods.has(name))}
      foodGroups={foodGroups}
      client:load
    />
  </div>
</SpicesLayout>
