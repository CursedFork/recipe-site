---
/* ---------------------------------------------------------------------------
   The Spices home. A short hub for now: it links to what exists. The blend
   finder, Top picks, Buy next and the shopping list arrive in later phases and
   will be added here when they are real pages. The finder is here from Phase 7.
   --------------------------------------------------------------------------- */

import SpicesLayout from "../../layouts/SpicesLayout.astro";
import PicksPanel from "../../islands/spices/PicksPanel.tsx";
import { buildFinderData } from "../../lib/spices/finder-data";
import { loadLibrary } from "../../lib/spices/load-spices";

const library = loadLibrary();
const data = buildFinderData();
---

<SpicesLayout
  title="Spices"
  description="A library of spices with how strong each one is, and which to use with what. Tick the ones in your kitchen."
>
  <div class="spices-page">
    <h1>Spices</h1>
    <p class="spices-page__lead">
      Ideas for the kitchen, not tied to any recipe here. Start with what is in
      your cabinet.
    </p>

    <div class="spices-hub__cards">
      <a class="spices-hub__card" href="/spices/library">
        <span class="spices-hub__card-title">Spice library</span>
        <p class="spices-hub__card-text">
          {library.spices.length} spices, each with how strong it is and what it goes
          with. Tick the ones you own. Your ticks stay in this browser and are
          not sent anywhere.
        </p>
      </a>

      <a class="spices-hub__card" href="/spices/blends">
        <span class="spices-hub__card-title">Spice blends</span>
        <p class="spices-hub__card-text">
          {library.blends.length} blends from around the world, with what each goes
          with and how to use it. Search by food, cuisine or spice.
        </p>
      </a>

      <a class="spices-hub__card" href="/spices/finder">
        <span class="spices-hub__card-title">What can I make?</span>
        <p class="spices-hub__card-text">
          Pick a food and see which blends you can make from the spices you have,
          and which are only one spice away.
        </p>
      </a>

      <a class="spices-hub__card" href="/spices/list">
        <span class="spices-hub__card-title">Shopping list</span>
        <p class="spices-hub__card-text">
          Spices to buy. Tick them off in the shop, then move them into your cabinet.
        </p>
      </a>
    </div>

    <PicksPanel blends={data.blends} stapleSlugs={data.stapleList} client:load />

    <p class="lib__hint">
      Pairings are traditional suggestions for inspiration, not rules. Your cabinet and
      list are saved in this browser only. Nothing is sent anywhere.
    </p>
  </div>
</SpicesLayout>
