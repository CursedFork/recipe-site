---
/* ---------------------------------------------------------------------------
   The layout every page uses. Static Astro, no JavaScript of its own except
   the theme script below, which is deliberately not React.
   --------------------------------------------------------------------------- */

// Self-hosted variable fonts. Served from our own domain, so there is no
// request to Google on any page view and nothing breaks on a school network
// that blocks third-party font CDNs.
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/hanken-grotesk";

// The two latin files, imported for their URLs so they can be preloaded.
//
// Without this the browser has to download the stylesheet, parse it, work out
// which @font-face it needs and only then ask for the font, so the first paint
// is in a fallback face and the text visibly reshuffles when the real one
// arrives. Preloading starts those two requests immediately.
//
// Only latin is preloaded. Fontsource splits each face into subsets by script,
// and preloading the cyrillic, greek and vietnamese files would download a few
// hundred kilobytes that this site will never render.
//
// Vite rewrites these to the hashed built filenames, which is why they are
// imported rather than written out as paths that would go stale every build.
import serifLatin from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import sansLatin from "@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url";

import "../styles/tokens.css";
import "../styles/global.css";
// Loaded on every page, but every rule in it sits inside @media print.
import "../styles/print.css";

import { site } from "../config/site";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  /** Page title. The site name is appended automatically. */
  title?: string;
  /** Meta description for this page. Falls back to the site description. */
  description?: string;
  /**
   * An image for link previews, as a path the site serves. Only set it where
   * there is a real picture of the page's subject: a recipe with a photo. A
   * page with nothing to show gets no image rather than a stand-in, because a
   * generic picture in a link preview is a small lie about what is behind it.
   */
  previewImage?: string;
}

const { title, description, previewImage } = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : site.name;
const pageDescription = description ?? site.description;

// Absolute URLs, which link previews and canonical tags both require.
// Astro.site comes from the `site` value in astro.config.ts.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const previewImageUrl = previewImage
  ? new URL(previewImage, Astro.site).href
  : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      The SVG is the real icon: it is tiny and it carries its own dark-mode
      variant, so it stays legible on a dark browser tab. The PNG is the
      fallback for anything that will not take an SVG, and the apple-touch
      icon is what iOS uses if someone saves this to their home screen. iOS
      ignores transparency, which is why that one has the warm ground baked in.
    */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    {/* crossorigin is required even for our own fonts: without it the browser
        treats the preload and the later CSS request as different fetches and
        downloads each file twice. */}
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {/*
      The canonical address of this page. It stops a search engine treating
      /map, /map/ and /map?region=IND as three different pages competing with
      each other, which is exactly what the filter and region query strings
      would otherwise cause.
    */}
    <link rel="canonical" href={canonical} />

    {/* What a link to this page looks like when pasted into a message. */}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {previewImageUrl && <meta property="og:image" content={previewImageUrl} />}

    <meta
      name="twitter:card"
      content={previewImageUrl ? "summary_large_image" : "summary"}
    />

    <meta name="author" content={site.author} />
    <link rel="sitemap" href="/sitemap.xml" />

    {/*
      Matches the browser chrome to the page background, so a phone does not
      put a bright white address bar above a dark page.

      It cannot be done with two media-query meta tags here, because the theme
      follows a stored choice rather than the operating system setting. The
      inline script below sets it to whichever theme actually applied, and the
      toggle updates it when you switch.
    */}
    <meta id="theme-color" name="theme-color" content="#F7F3EC" />

    {/*
      The theme, applied before the browser paints anything.

      This is the part that stops the page flashing light before it goes dark,
      and it has to be an inline script in the head to work. The React toggle
      cannot do this job, because by the time React runs the page has already
      painted. `is:inline` tells Astro to leave this alone rather than bundle
      it, which is what keeps it synchronous and ahead of first paint.

      Reads are wrapped in try/catch because localStorage throws outright in
      some private browsing modes rather than returning null.

      No stored choice means light, which is the default the spec asks for.
      Light needs no attribute, since :root is already light.
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored === "dark" || stored === "light") {
            document.documentElement.dataset.theme = stored;
          }
        } catch (error) {
          /* No stored preference available. Light it is. */
        }

        // Keep the browser chrome colour in step with the theme that just
        // applied. These two values are --bg from tokens.css.
        var meta = document.getElementById("theme-color");
        if (meta) {
          meta.setAttribute(
            "content",
            document.documentElement.dataset.theme === "dark" ? "#1C1A18" : "#F7F3EC",
          );
        }
      })();
    </script>
  </head>

  <body>
    <a class="visually-hidden skip-link" href="#main">Skip to content</a>

    <SiteHeader />

    <main id="main" class="page" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
